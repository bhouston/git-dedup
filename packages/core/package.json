{
  "name": "git-dedup-core",
  "version": "0.1.0",
  "description": "Consolidated Git storage with a shared object pool",
  "keywords": [
    "alternates",
    "clone",
    "deduplication",
    "git",
    "object-pool",
    "shared-storage",
    "storage",
    "submodule",
    "worktree"
  ],
  "homepage": "https://git-dedup.ben3d.ca",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bhouston/git-dedup.git",
    "directory": "packages/core"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc",
    "tsc": "tsc --noEmit"
  },
  "engines": {
    "node": ">=22"
  }
}
