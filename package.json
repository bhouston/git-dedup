{
  "name": "git-dedup-workspace",
  "private": true,
  "description": "Git checkouts backed by a shared object pool",
  "license": "MIT",
  "repository": "github:bhouston/git-dedup",
  "type": "module",
  "scripts": {
    "build": "node scripts/build-native.mjs",
    "typecheck": "go vet ./...",
    "test": "pnpm build && vitest run",
    "test:watch": "vitest",
    "lint": "oxlint .",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "docs:build": "pnpm --filter git-dedup-website build",
    "dev": "pnpm --filter git-dedup-website dev",
    "check": "pnpm lint && pnpm format:check && pnpm typecheck && pnpm test && pnpm test:workflow && pnpm package:check && pnpm docs:build",
    "test:proof": "pnpm build && node scripts/prove-storage.mjs",
    "prepare": "husky",
    "tsc": "pnpm typecheck",
    "lint:fix": "oxlint --fix .",
    "release": "semantic-release",
    "test:coverage": "node scripts/native-test.mjs --coverage",
    "test:workflow": "node --test scripts/workflow.test.mjs",
    "package:check": "node scripts/check-packages.mjs",
    "docs:generate": "pnpm build && node scripts/generate-docs.mjs",
    "go:release:snapshot": "goreleaser release --snapshot --clean --skip=sbom"
  },
  "devDependencies": {
    "@anolilab/semantic-release-pnpm": "^8.1.29",
    "@clidoc/core": "^0.1.0",
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "@semantic-release/commit-analyzer": "^13.0.1",
    "@semantic-release/github": "^12.0.9",
    "@semantic-release/release-notes-generator": "^14.1.1",
    "@types/node": "^24.13.5",
    "@visulima/yaml": "1.0.0",
    "conventional-changelog-conventionalcommits": "^9.3.1",
    "husky": "^9.1.7",
    "lint-staged": "^17.5.1",
    "oxfmt": "^0.58.0",
    "oxlint": "^1.83.0",
    "semantic-release": "^25.0.9",
    "vitest": "^4.1.11",
    "vitest-command-line": "^0.9.1"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,mjs,cjs}": [
      "oxfmt --no-error-on-unmatched-pattern",
      "oxlint --fix --no-error-on-unmatched-pattern"
    ],
    "*.{json,jsonc,md,mdx,css,html,yml,yaml}": "oxfmt --no-error-on-unmatched-pattern"
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@11.1.3"
}
